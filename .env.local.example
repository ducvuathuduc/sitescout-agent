# ---------------------------------------------------------------------------
# SiteScout local config — COPY to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------
# WARNING: treat GEOAPIFY_API_KEY like a password. .env.local is gitignored.
#
# Get a key:
#   - Geoapify free tier (3,000 credits/day, no card): https://www.geoapify.com/
#   - Open Geospatial Program Batch #2 "AI x Geospatial": selected projects
#     receive extended API access + a dedicated key.
GEOAPIFY_API_KEY=YOUR_KEY

# --- Optional: older MCP ask pipeline budget -----------------------------------
# SITESCOUT_BUDGET applies to ask, not scout. Leave commented for no ask cap.
# The ask planner checks estimated credits before scheduling each tool call.
# SITESCOUT_BUDGET=300
#
# scout uses --credit-cap instead (default 300). It checks accumulated credits
# before a request; the final request can cross that threshold.
# Costs vary by question; see docs/demo-proxy.md for the dated credit rules.
#
# Optional LLM planner for scout --planner llm (rules are the default):
# SITESCOUT_LLM_BASE_URL=https://api.groq.com/openai/v1
# SITESCOUT_LLM_MODEL=llama-3.3-70b-versatile
# SITESCOUT_LLM_API_KEY=YOUR_KEY
