{
  "bin": {
    "sitescout": "dist/cli.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "description": "Evidence-traced AI agent for SME site selection in Vietnam — MCP-first on the Geoapify MCP server.",
  "devDependencies": {
    "@types/node": "^20.12.0",
    "eslint": "^9.39.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "name": "sitescout-agent",
  "scripts": {
    "ask": "node dist/cli.js ask",
    "smoke": "node dist/cli.js smoke",
    "trace:validate": "node dist/cli.js trace validate",
    "bench": "node dist/cli.js bench run",
    "static": "node dist/cli.js static",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
